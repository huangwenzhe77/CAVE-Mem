# Copy to configs/gpt-5.6-terra.env, fill in the key, then source that file.
# This shell file does not change the actor model by itself; select the matching TOML config.
export OPENAI_API_KEY="replace-with-your-key"
export OPENAI_BASE_URL="https://api.aicodemirror.ai"
export OPENAI_MODEL="gpt-5.6-terra"

export LLM_API_KEY="$OPENAI_API_KEY"
export LLM_BASE_URL="$OPENAI_BASE_URL"
export LLM_MODEL="$OPENAI_MODEL"
